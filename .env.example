# Gmail / Google Workspace sender account
GMAIL_USER=
# 16-character Google App Password, NOT your regular account password
GMAIL_APP_PASSWORD=
# Optional: defaults to GMAIL_USER; a single recipient email address
ASSESSMENT_TO_EMAIL=

# Optional search ownership tokens (raw token, not the full meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
